{
  "name": "focus-protocol",
  "productName": "Focus Protocol",
  "version": "1.3.0",
  "description": "A four-phase deep work app: pre-load, activate, immerse (pomodoro + binaural beats), exit.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "io.github.focusprotocol",
    "publish": {
      "provider": "github",
      "owner": "NathanLaborada",
      "repo": "focus-protocol"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "app.js",
      "icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "artifactName": "Focus-Protocol-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Focus-Protocol-Portable-${version}.${ext}"
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "universal"
        ]
      },
      "icon": "icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "Focus-Protocol-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png",
      "category": "Utility"
    },
    "appImage": {
      "artifactName": "Focus-Protocol-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
